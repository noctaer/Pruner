<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LuaCleaner.UI.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processar Pasta - CodeCleaner"
        Width="680" Height="540"
        MinWidth="560" MinHeight="420"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="BatchPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3F5A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E5270"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2D42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2D3E"/>
                                <Setter Property="Foreground" Value="#4A4A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BatchAccentButton" TargetType="Button" BasedOn="{StaticResource BatchPrimaryButton}">
            <Setter Property="Background" Value="#4A90D9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5BA3F0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3A7BC8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A4A6A"/>
                    <Setter Property="Foreground" Value="#4A6A8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Processar Pasta" Foreground="#E0E0E0" FontSize="18"
                       FontWeight="SemiBold" FontFamily="Segoe UI"/>
            <TextBlock x:Name="TxtFolderPath" Text="" Foreground="#6B6B8A"
                       FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Stats -->
        <Border Grid.Row="2" Background="#13131F" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Arquivos" Foreground="#6B6B8A" FontSize="9" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtStatFiles" Text="-" Foreground="#E0E0E0"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Comentarios" Foreground="#6B6B8A" FontSize="9" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtStatComments" Text="-" Foreground="#E0E0E0"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Original" Foreground="#6B6B8A" FontSize="9" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtStatOriginal" Text="-" Foreground="#E0E0E0"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Economizado" Foreground="#6B6B8A" FontSize="9" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtStatSaved" Text="-" Foreground="#4CAF50"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Falhas" Foreground="#6B6B8A" FontSize="9" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtStatErrors" Text="-" Foreground="#E0E0E0"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overwrite option -->
        <Border Grid.Row="4" Background="#2A1A1A" BorderBrush="#5A3030" BorderThickness="1"
                CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkOverwrite" Grid.Column="0"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          Checked="ChkOverwrite_Changed" Unchecked="ChkOverwrite_Changed"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Sobrescrever arquivos originais"
                               Foreground="#E0A0A0" FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Os arquivos originais serao substituidos. Esta operacao nao pode ser desfeita."
                               Foreground="#8A5050" FontSize="10" FontFamily="Segoe UI"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="6" Background="#13131F" CornerRadius="8" BorderBrush="#2A2D42" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1A1A2E" CornerRadius="8,8,0,0" Padding="12,8">
                    <TextBlock x:Name="TxtLogHeader" Text="Aguardando..." Foreground="#6B6B8A"
                               FontSize="11" FontFamily="Segoe UI"/>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,8">
                    <StackPanel x:Name="LogPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100"
                             Value="0" Background="#2A2D3E" Foreground="#4A90D9"
                             BorderThickness="0" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtProgress" Text="" Foreground="#6B6B8A"
                           FontSize="11" FontFamily="Segoe UI" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="BtnProcess" Grid.Column="1"
                    Style="{StaticResource BatchAccentButton}"
                    Content="Processar" Click="BtnProcess_Click"/>
            <Button x:Name="BtnClose" Grid.Column="3"
                    Style="{StaticResource BatchPrimaryButton}"
                    Content="Fechar" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>