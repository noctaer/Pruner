<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LuaCleaner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="CodeCleaner"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3F5A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E5270"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2D42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4A90D9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5BA3F0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3A7BC8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3C3F5A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodePanel" TargetType="Border">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#2A2D42"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox dark theme -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="#2A2D3E" BorderBrush="#3C3F5A" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9090B0"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2D3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3C3F5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboBoxToggleButton}"
                                         IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                             RelativeSource={RelativeSource TemplatedParent}}"
                                         Focusable="False"/>
                            <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2A2D3E" BorderBrush="#3C3F5A" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer Background="#2A2D3E">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2D3E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3C3F5A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#4A90D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar dark theme for AvalonEdit -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="#161622" CornerRadius="3"/>
                            <RepeatButton Grid.Row="0" Height="0" Opacity="0" Focusable="False"/>
                            <Track Grid.Row="1" Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3C3F5A" CornerRadius="3" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Height="0" Opacity="0" Focusable="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" Background="#161622" CornerRadius="3"/>
                                    <RepeatButton Grid.Column="0" Width="0" Opacity="0" Focusable="False"/>
                                    <Track Grid.Column="1" Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#3C3F5A" CornerRadius="3" Margin="0,2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Width="0" Opacity="0" Focusable="False"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#13131F" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" Background="#7C3AED" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="CC" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CodeCleaner" Foreground="#E0E0E0" FontSize="15"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>
                    <TextBlock Text="Remove comentarios de qualquer linguagem" Foreground="#6B6B8A"
                               FontSize="11" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#1A1A2E" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnOpenFile" Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,8,10,8"
                                Click="BtnOpenFile_Click">
                            <TextBlock Text="Abrir arquivo"/>
                        </Button>
                        <Rectangle Grid.Column="1" Fill="#4E5270" VerticalAlignment="Stretch" Margin="0,6"/>
                        <Button x:Name="BtnRecentDropdown" Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0" Width="28"
                                Click="BtnRecentDropdown_Click"
                                ToolTip="Arquivos recentes">
                            <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="#9090B0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Popup x:Name="RecentPopup" Grid.Column="0"
                               PlacementTarget="{Binding ElementName=BtnOpenFile}"
                               Placement="Bottom" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#2A2D3E" BorderBrush="#3C3F5A" BorderThickness="1"
                                    CornerRadius="6" MinWidth="280" MaxWidth="480"
                                    Effect="{x:Null}">
                                <StackPanel x:Name="RecentList" Margin="4"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="BtnPasteCode" Style="{StaticResource GhostButton}"
                            Margin="0,0,16,0" Click="BtnPasteCode_Click">
                        <TextBlock Text="Colar codigo"/>
                    </Button>
                    <TextBlock Text="Linguagem:" Foreground="#6B6B8A" FontSize="12"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguageSelector" Width="160" Height="32"/>
                    <Border x:Name="LanguageWarning" Visibility="Collapsed"
                            Background="#3D2E00" BorderBrush="#C8A84B" BorderThickness="1"
                            CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLanguageWarning"
                                   Text="Linguagem manual"
                                   Foreground="#C8A84B" FontSize="11" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnBatch" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="BtnBatch_Click">
                        <TextBlock Text="Processar pasta"/>
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="BtnSettings_Click">
                        <TextBlock Text="Configuracoes"/>
                    </Button>
                    <Button x:Name="BtnHelp" Style="{StaticResource GhostButton}"
                            Click="BtnHelp_Click">
                        <TextBlock Text="Ajuda"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Original code panel -->
            <Border Grid.Column="0" Style="{StaticResource CodePanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1E1E30" CornerRadius="8,8,0,0" Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&lt;/&gt;" Foreground="#4A90D9" FontSize="12"
                                           FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="CODIGO ORIGINAL" Foreground="#9090B0" FontSize="11"
                                           FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOriginalFileName" Text="" Foreground="#6B6B8A"
                                           FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtOriginalSize" Text="" Foreground="#6B6B8A"
                                           FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <avalon:TextEditor x:Name="EditorOriginal"
                                       Grid.Row="1"
                                       FontFamily="Consolas" FontSize="13"
                                       Background="#161622" Foreground="#D4D4D4"
                                       LineNumbersForeground="#3C3F5A"
                                       ShowLineNumbers="True" IsReadOnly="False"
                                       WordWrap="False" Padding="4,4"
HorizontalScrollBarVisibility="Hidden"
VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- Clean code panel -->
            <Border Grid.Column="2" Style="{StaticResource CodePanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1E1E30" CornerRadius="8,8,0,0" Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CODIGO LIMPO" Foreground="#9090B0" FontSize="11"
                                           FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCleanFileName" Text="" Foreground="#6B6B8A"
                                           FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtCleanSize" Text="" Foreground="#6B6B8A"
                                           FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <avalon:TextEditor x:Name="EditorClean"
                                       Grid.Row="1"
                                       FontFamily="Consolas" FontSize="13"
                                       Background="#161622" Foreground="#D4D4D4"
                                       LineNumbersForeground="#3C3F5A"
                                       ShowLineNumbers="True" IsReadOnly="True"
                                       WordWrap="False" Padding="4,4"
HorizontalScrollBarVisibility="Hidden"
VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="3" Background="#13131F" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyCode" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="BtnCopyCode_Click">
                        <TextBlock Text="Copiar codigo"/>
                    </Button>
                    <Button x:Name="BtnSaveCode" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="BtnSaveCode_Click">
                        <TextBlock Text="Salvar codigo"/>
                    </Button>
                    <Button x:Name="BtnClearAll" Style="{StaticResource GhostButton}"
                            Click="BtnClearAll_Click">
                        <TextBlock Text="Limpar tudo"/>
                    </Button>
                </StackPanel>

                <Button x:Name="BtnProcess" Style="{StaticResource AccentButton}"
                        Width="280" Height="52" DockPanel.Dock="Left"
                        HorizontalAlignment="Center" Click="BtnProcess_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="REMOVER COMENTARIOS" FontSize="14" FontWeight="Bold"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        <TextBlock Text="Processar codigo e remover todos os comentarios"
                                   FontSize="10" Foreground="#B0D0F8" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Border VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Dica" Foreground="#C8A84B" FontSize="12"
                                   FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtHint"
                                   Text="Abra um arquivo ou cole codigo para comecar."
                                   Foreground="#6B6B8A" FontSize="11" FontFamily="Segoe UI"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#0F0F1A" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtStatusTitle" Text="Pronto" Foreground="#4CAF50"
                                   FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtStatusDetail" Text="Aguardando codigo..."
                                   Foreground="#6B6B8A" FontSize="10" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel>
                            <TextBlock Text="Comentarios removidos" Foreground="#6B6B8A" FontSize="9"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtCommentsRemoved" Text="0" Foreground="#E0E0E0"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel>
                            <TextBlock Text="Tamanho original" Foreground="#6B6B8A" FontSize="9"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtOriginalSizeStat" Text="-" Foreground="#E0E0E0"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel>
                            <TextBlock Text="Tamanho limpo" Foreground="#6B6B8A" FontSize="9"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtCleanSizeStat" Text="-" Foreground="#E0E0E0"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Reducao" Foreground="#6B6B8A" FontSize="9"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtReduction" Text="-" Foreground="#E0E0E0"
                                       FontSize="14" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="LuaCleaner v1.0.0  -  C# e .NET  -  Windows"
                           Foreground="#3A3A5A" FontSize="10" FontFamily="Segoe UI"/>
            </Grid>
        </Border>
    </Grid>
</Window>